{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core_memory.legacy_inventory.v1",
  "type": "object",
  "required": [
    "schema_version",
    "scanner",
    "source_label",
    "tenant_workspace_classification",
    "root_fingerprint",
    "classification_schema_version",
    "classification_checksum",
    "read_only",
    "complete",
    "summary",
    "records",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "core_memory.legacy_inventory.v1"},
    "scanner": {"enum": ["static_code", "filesystem"]},
    "source_label": {"type": "string", "minLength": 1},
    "tenant_workspace_classification": {"type": "string", "minLength": 1},
    "root_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification_schema_version": {"const": "core_memory.legacy_inventory_classification.v1"},
    "classification_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "read_only": {"const": true},
    "complete": {"type": "boolean"},
    "summary": {"type": "object"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "warnings": {"type": "array"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "inventory_id",
        "source_label",
        "tenant_workspace_classification",
        "locator",
        "locator_kind",
        "authority_classification",
        "record_kind",
        "record_count",
        "byte_count",
        "min_event_time",
        "max_event_time",
        "stable_hash",
        "parse_failure_count",
        "duplicate_id_count",
        "recoverability_status",
        "provenance_classification",
        "reader_symbols",
        "writer_symbols",
        "proposed_future_importer",
        "planned_deletion_pr"
      ],
      "properties": {
        "inventory_id": {"type": "string", "pattern": "^inv_[0-9a-f]{24}$"},
        "source_label": {"type": "string"},
        "tenant_workspace_classification": {"type": "string"},
        "locator": {"type": "string"},
        "locator_kind": {"type": "string"},
        "authority_classification": {"type": "string", "minLength": 1},
        "record_kind": {"type": "string", "minLength": 1},
        "record_count": {"type": "integer", "minimum": 0},
        "byte_count": {"type": "integer", "minimum": 0},
        "min_event_time": {"type": ["string", "null"]},
        "max_event_time": {"type": ["string", "null"]},
        "stable_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parse_failure_count": {"type": "integer", "minimum": 0},
        "duplicate_id_count": {"type": "integer", "minimum": 0},
        "recoverability_status": {"type": "string"},
        "provenance_classification": {"type": "string"},
        "reader_symbols": {"type": "array", "items": {"type": "string"}},
        "writer_symbols": {"type": "array", "items": {"type": "string"}},
        "proposed_future_importer": {"type": "string", "minLength": 1},
        "planned_deletion_pr": {"type": "string", "pattern": "^PR-[0-9]{2}[A-Z]$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
