{"contract":"core_memory.record.v1","record_key":"chunk:cfc2e835-9643-8fe5-93bd-2197acab9467","scope":"acme","record_kind":"chunk","event":{"event_id":"6cd4f831-e8a3-8bda-8594-f002b34a7246","key":{"scope":"acme","source_ns":"docs/conformance","external_id":"cutover-plan.md","revision":"v1"},"event_hash":"841ed1ed146e3c01ba692e70fa4f4f5c0508176e9cdbbc1ce9407b6de95c2c9a","content_hash":"9e6085fadd25ab326eac2ee5c46af01331f4d1ab84d92a6892f521c54316fdfb","content_kind":"text","source_type":"document","source_system":"docs","media_type":"text/markdown","structure":{"document":{"title":"Cutover plan"}},"parser_contract_version":"conformance/1","captured_at":"2026-10-27T03:33:20Z","chunk_count":2},"memory":{"chunk":{"chunk_id":"cfc2e835-9643-8fe5-93bd-2197acab9467","ordinal":0,"byte_start":0,"byte_end":289,"char_start":0,"char_end":289,"content_hash":"cd99a743766f8268bfc1f0f411346a3e5884e1554bf76f9ec13b120a1d0797c6","text":"Cutover plan for the billing ledger. We decided to move read traffic first, because a failed read is cheap to retry and a failed write is not.\n\nPriya will own the export job and report its runtime every morning until it finishes in under an hour. The current run takes about three hours.\n\n"},"type":{"status":"assigned","type_ref":{"key":"decision","rev":1}}},"facets":{"lengths":{"bytes":289,"code_points":289,"lines":4},"language":"eng","extractors":{"language":1,"lengths":1,"urls":1}},"source_profile":{"id":"conformance.notes","rev":1},"chunker":{"id":"text.structural","rev":1,"config_hash":"e30626ff5cf722b8eb62055b31b3f2598854155dd9861f3f66ca7018918d4165"},"catalogs":{"type":{"id":"memoriesql.bead_types","hash":"12a8b29e41ed93de45bb0ecc6cb3fb10a4ca406e5e2904f93262429540ef95b9"}},"decision":{"decision_id":"107cf5ad-97f2-85d3-98e2-f3da972b90fc","method":"model","binding_ref":"keywords","binding_rev":"0e642429439a5f70b587b61f19d251c9920f1d6000d1024073fdaad4077c322b","decided_at":"2026-10-27T03:33:20Z"},"relationships":{"stage":"off"}}
